# moocher agent image: OpenCode + moo-bridge, nothing else listens.
#
#   podman build -t localhost/moocher-agent:1.19.4 \
#     --build-arg OPENCODE_VERSION=1.19.4 -f images/agent/Containerfile .
#
# Behind a TLS-intercepting proxy, add: -v /path/ca.crt:/run/extra-ca.crt:ro
# (apt then switches to https mirrors and trusts that CA during the build only).
ARG OPENCODE_VERSION=1.19.4
ARG BASE_IMAGE=docker.io/library/debian:bookworm-slim

FROM docker.io/library/node:22-slim AS fetch
ARG OPENCODE_VERSION
RUN if [ -f /run/extra-ca.crt ]; then export NODE_EXTRA_CA_CERTS=/run/extra-ca.crt; fi; \
    npm i -g "opencode-ai@${OPENCODE_VERSION}" \
 && cp "$(npm root -g)/opencode-ai/bin/opencode.exe" /opencode \
 && /opencode --version

FROM ${BASE_IMAGE}
RUN if [ -f /run/extra-ca.crt ]; then \
      echo 'Acquire::https::CAInfo "/run/extra-ca.crt";' > /etc/apt/apt.conf.d/99extra-ca; \
      sed -i "s|http://|https://|g" /etc/apt/sources.list.d/*.sources; \
    fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git python3 python3-pytest procps ripgrep \
 && rm -rf /var/lib/apt/lists/* /etc/apt/apt.conf.d/99extra-ca \
 && (userdel -r ubuntu 2>/dev/null || true) \
 && useradd -m -u 1000 agent
COPY --from=fetch /opencode /usr/local/bin/opencode
COPY target/x86_64-unknown-linux-musl/release/moo-bridge /usr/local/bin/moo-bridge
ENV OPENCODE_DISABLE_AUTOUPDATE=1 \
    HOME=/home/agent
USER agent
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/moo-bridge"]
