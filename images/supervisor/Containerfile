# moocher supervisor image (for the Quadlet in deploy/quadlet).
#
#   cargo build --release -p moocher-hub -p moo
#   podman build -t localhost/moocher-hub -f images/supervisor/Containerfile .
#
# The binary embeds the dashboard and needs only glibc (it links libc, libm
# and libgcc_s), so the base is the same Debian release as the agent image.
ARG BASE_IMAGE=docker.io/library/debian:bookworm-slim
FROM ${BASE_IMAGE}
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --no-create-home --uid 10001 --shell /usr/sbin/nologin moo
COPY target/release/moocher-hub /usr/local/bin/moocher-hub
COPY target/release/moo /usr/local/bin/moo
USER 10001:10001
VOLUME /config
EXPOSE 7700 7443 7444
ENTRYPOINT ["/usr/local/bin/moocher-hub"]
CMD ["--config-dir", "/config", "run"]
