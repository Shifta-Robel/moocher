# moocher hub: the supervisor (API, dashboard, node links, artifacts).
#
#   install -m 0644 deploy/systemd/moocher-hub.service /etc/systemd/system/
#   useradd --system --home-dir /var/lib/moo --shell /usr/sbin/nologin moo
#   systemctl enable --now moocher-hub
#
# Config and state live in /var/lib/moo/hub (supervisor.yaml, agents/, …;
# the database under hub/supervisor/). Set in supervisor.yaml:
#   link_socket: /run/moo-hub/link.sock      # the hub's own node connects here
[Unit]
Description=moocher supervisor
Documentation=file:///usr/share/doc/moocher/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=moo
Group=moo
ExecStart=/usr/local/bin/moocher-hub --config-dir /var/lib/moo/hub run
Restart=on-failure
RestartSec=5s
# Node links reconnect on their own; give in-flight requests a moment.
TimeoutStopSec=20s
Environment=RUST_LOG=info

StateDirectory=moo moo/hub
StateDirectoryMode=0750
RuntimeDirectory=moo-hub
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
UMask=0027

# Ports 80/443 (ACME HTTP-01, HTTPS) without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
