# opencode-cluster node, rootless Podman, as a systemd *user* service.
#
#   install -D -m 0644 deploy/systemd/opencode-node.user.service \
#       ~/.config/systemd/user/opencode-node.service
#   loginctl enable-linger "$USER"     # keep it running without a login
#   systemctl --user enable --now opencode-node
#
# Config in ~/.config/ocl/node (node.yaml, agents/, providers.yaml). Session
# sockets go to $XDG_RUNTIME_DIR/ocl. `disk_enforce: hard` is not available
# rootless (quotas need root); `soft` is the default.
[Unit]
Description=opencode-cluster node (rootless)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=%h/.local/bin/opencode-node --config-dir %E/ocl/node run
Restart=on-failure
RestartSec=5s
KillMode=process
TimeoutStopSec=20s
Environment=RUST_LOG=info
#LoadCredentialEncrypted=openrouter:%E/ocl/creds/openrouter.cred
# No NoNewPrivileges/PrivateTmp: rootless Podman needs the setuid newuidmap
# and newgidmap helpers to set up its user namespace.
LimitNOFILE=65536

[Install]
WantedBy=default.target
