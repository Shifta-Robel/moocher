# The supervisor as a Podman Quadlet (a systemd service generated by Podman).
#
#   podman build -t localhost/ocl-supervisor -f images/supervisor/Containerfile .
#   install -m 0644 deploy/quadlet/ocl-supervisor.container /etc/containers/systemd/
#   systemctl daemon-reload && systemctl start ocl-supervisor
#
# Config and state: /var/lib/ocl/hub on the host, /config in the container
# (owned by uid 10001). The hub's own node runs on the host (opencode-node.service)
# and connects to the link socket through /run/ocl-hub, so in supervisor.yaml:
#   api_listen: 0.0.0.0:7700
#   link_socket: /run/ocl-hub/link.sock
[Unit]
Description=opencode-cluster supervisor (container)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/ocl-supervisor:latest
Exec=--config-dir /config run
Volume=/var/lib/ocl/hub:/config:Z
Volume=/run/ocl-hub:/run/ocl-hub:z
# API/dashboard, node links (mTLS), Open in OpenCode.
PublishPort=7700:7700
PublishPort=7443:7443
PublishPort=7444:7444
User=10001
Group=10001
ReadOnly=yes
NoNewPrivileges=yes
DropCapability=ALL
Environment=RUST_LOG=info
HealthCmd=/usr/local/bin/ocl-supervisor --config-dir /config audit-verify
HealthInterval=10m

[Service]
ExecStartPre=/usr/bin/install -d -m 0750 -o 10001 -g 10001 /var/lib/ocl/hub /run/ocl-hub
Restart=on-failure
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target default.target
